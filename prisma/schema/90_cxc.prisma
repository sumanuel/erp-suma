// Cuentas por cobrar. Un cobro (recibo) reparte lo recibido entre las facturas abiertas de un cliente y baja su saldo. Todo se lleva en USD:
// si el cliente paga en bolívares, se guarda el monto en Bs. que correspondió con la tasa del día, pero lo aplicado a la factura es el equivalente en USD.
// Anticipos y pagos sin factura quedan para Tesorería. Un cobro registrado no se edita: se anula (restituye los saldos) y se registra otro.

model Cobro {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Número correlativo (se muestra como COB-000123).
  numero          Int               @unique @default(autoincrement())
  clienteId       String            @map("cliente_id") @db.Uuid
  cliente         Cliente           @relation(fields: [clienteId], references: [id])
  fecha           DateTime          @db.Date
  /// REGISTRADO, ANULADO
  estado          String            @default("REGISTRADO")
  /// EFECTIVO, TRANSFERENCIA, PAGO_MOVIL, PUNTO_VENTA, ZELLE, CHEQUE, OTRO
  formaPago       String            @map("forma_pago")
  /// USD o VES: la moneda en que el cliente pagó.
  moneda          String
  /// Monto en la moneda en que pagó el cliente.
  montoMoneda     Decimal           @map("monto_moneda") @db.Decimal(18, 2)
  /// Bolívares por 1 USD al cobrar (solo si pagó en VES).
  tasaUsd         Decimal?          @map("tasa_usd") @db.Decimal(18, 8)
  /// Total aplicado a facturas, en USD.
  montoUsd        Decimal           @map("monto_usd") @db.Decimal(18, 4)
  /// Cuenta de tesorería a la que entró el dinero (nulo solo en cobros anteriores a Tesorería).
  cuentaId        String?           @map("cuenta_id") @db.Uuid
  cuenta          CuentaTesoreria?  @relation(fields: [cuentaId], references: [id])
  /// Recibo de ingreso al que pertenece cuando el cliente paga con varias formas de pago a la vez (cada forma es un cobro).
  reciboId        String?           @map("recibo_id") @db.Uuid
  recibo          ReciboCobro?      @relation(fields: [reciboId], references: [id])
  cobradorId      String?           @map("cobrador_id") @db.Uuid
  /// Pago con cheque: banco emisor, número y fecha del cheque.
  bancoChequeId   String?           @map("banco_cheque_id") @db.Uuid
  numeroCheque    String?           @map("numero_cheque")
  fechaCheque     DateTime?         @map("fecha_cheque") @db.Date
  /// Lo recibido de más (o sin facturas): saldo a favor del cliente (anticipo) en USD, su valor en bolívares al recibirlo y lo que aún no se aplica.
  anticipoUsd      Decimal          @default(0) @map("anticipo_usd") @db.Decimal(18, 4)
  anticipoBs       Decimal          @default(0) @map("anticipo_bs") @db.Decimal(18, 2)
  anticipoSaldoUsd Decimal          @default(0) @map("anticipo_saldo_usd") @db.Decimal(18, 4)
  anticipoAplicaciones AnticipoAplicacion[]
  /// Comprobante contable o de caja del cobro.
  numeroComprobante String?         @map("numero_comprobante")
  referencia      String?
  observaciones   String?
  creadoPorId     String?           @map("creado_por_id") @db.Uuid
  creadoPorNombre String?           @map("creado_por_nombre")
  creadoEn        DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)
  anuladoEn       DateTime?         @map("anulado_en") @db.Timestamptz(6)
  anuladoPorNombre String?          @map("anulado_por_nombre")
  motivoAnulacion String?           @map("motivo_anulacion")
  aplicaciones    CobroAplicacion[]

  @@index([clienteId, fecha(sort: Desc)])
  @@index([estado])
  @@map("cobro")
}

model CobroAplicacion {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cobroId   String  @map("cobro_id") @db.Uuid
  cobro     Cobro   @relation(fields: [cobroId], references: [id], onDelete: Cascade)
  facturaId String  @map("factura_id") @db.Uuid
  factura   Factura @relation(fields: [facturaId], references: [id])
  /// USD que este cobro aplicó a la factura.
  montoUsd  Decimal @map("monto_usd") @db.Decimal(18, 4)

  @@unique([cobroId, facturaId])
  @@index([facturaId])
  @@map("cobro_aplicacion")
}

/// Recibo de ingreso: agrupa los cobros de una misma operación (por ejemplo, 50 USD en efectivo + el resto por transferencia). Equivale a admreciboingre.
model ReciboCobro {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Número correlativo (se muestra como REC-000123).
  numero          Int      @unique @default(autoincrement())
  clienteId       String   @map("cliente_id") @db.Uuid
  fecha           DateTime @db.Date
  cobradorId      String?  @map("cobrador_id") @db.Uuid
  observaciones   String?
  creadoPorId     String?  @map("creado_por_id") @db.Uuid
  creadoPorNombre String?  @map("creado_por_nombre")
  creadoEn        DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  cobros          Cobro[]

  @@index([clienteId, fecha(sort: Desc)])
  @@map("recibo_cobro")
}

/// Aplicación de un anticipo (saldo a favor de un cobro) a una factura. Baja el saldo de la factura sin mover dinero. Se muestra como AA-000123.
model AnticipoAplicacion {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero           Int      @unique @default(autoincrement())
  cobroId          String   @map("cobro_id") @db.Uuid
  cobro            Cobro    @relation(fields: [cobroId], references: [id])
  facturaId        String   @map("factura_id") @db.Uuid
  factura          Factura  @relation(fields: [facturaId], references: [id])
  fecha            DateTime @db.Date
  montoUsd         Decimal  @map("monto_usd") @db.Decimal(18, 4)
  /// ACTIVA o ANULADA
  estado           String   @default("ACTIVA")
  creadoPorId      String?  @map("creado_por_id") @db.Uuid
  creadoPorNombre  String?  @map("creado_por_nombre")
  creadoEn         DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  anuladoEn        DateTime? @map("anulado_en") @db.Timestamptz(6)
  anuladoPorNombre String?  @map("anulado_por_nombre")
  motivoAnulacion  String?  @map("motivo_anulacion")

  @@index([cobroId])
  @@index([facturaId])
  @@map("anticipo_aplicacion")
}
