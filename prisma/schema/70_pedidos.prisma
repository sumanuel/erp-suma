// Pedidos de venta. Un pedido CONFIRMADO reserva mercancía: la cantidad reservada de un producto es la suma de sus líneas en pedidos
// confirmados (no se toca `existencia`, que solo mueve el inventario real). Al facturarse, la factura lo pasa a FACTURADO y libera la reserva.
// Precios en USD; la tasa se congela al confirmar para poder mostrar y facturar en bolívares con la misma tasa.

model PedidoVenta {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Número correlativo (se muestra como PED-000123).
  numero          Int               @unique @default(autoincrement())
  clienteId       String            @map("cliente_id") @db.Uuid
  cliente         Cliente           @relation(fields: [clienteId], references: [id])
  /// Cotización de la que nació, si vino de una.
  cotizacionId    String?           @map("cotizacion_id") @db.Uuid
  cotizacion      Cotizacion?       @relation(fields: [cotizacionId], references: [id])
  fecha           DateTime          @db.Date
  /// BORRADOR, POR_APROBAR, CONFIRMADO, FACTURADO, ANULADO
  estado          String            @default("BORRADOR")
  /// Condiciones comerciales (vienen del cliente y se pueden cambiar en el documento).
  vendedorId      String?  @map("vendedor_id") @db.Uuid
  condicionPagoId String?  @map("condicion_pago_id") @db.Uuid
  transporteId    String?  @map("transporte_id") @db.Uuid
  direccionEntrega String? @map("direccion_entrega")
  origenVentaId    String? @map("origen_venta_id") @db.Uuid
  bultos           Int?
  kilos            Decimal? @db.Decimal(18, 3)
  /// Pronto pago (se copia de la condición de pago): si paga dentro de N días, el porcentaje de descuento. Dos escalones.
  prontoPagoDias1  Int     @default(0) @map("pronto_pago_dias_1")
  prontoPagoPct1   Decimal @default(0) @map("pronto_pago_pct_1") @db.Decimal(7, 4)
  prontoPagoDias2  Int     @default(0) @map("pronto_pago_dias_2")
  prontoPagoPct2   Decimal @default(0) @map("pronto_pago_pct_2") @db.Decimal(7, 4)
  /// Descuentos globales 1, 2 y 3 (%): se aplican en cadena a todas las líneas (quedan dentro del descuento de cada línea).
  descuentoGlobal1 Decimal @default(0) @map("descuento_global_1") @db.Decimal(7, 4)
  descuentoGlobal2 Decimal @default(0) @map("descuento_global_2") @db.Decimal(7, 4)
  descuentoGlobal3 Decimal @default(0) @map("descuento_global_3") @db.Decimal(7, 4)
  /// Aprobación gerencial: regla que lo dejó POR_APROBAR y la decisión del gerente (APROBADO/RECHAZADO).
  reglaRechazoId  Int?     @map("regla_rechazo_id") @db.SmallInt
  reglaRechazo    ReglaAprobacion? @relation(fields: [reglaRechazoId], references: [id])
  aprobacionEstado String? @map("aprobacion_estado")
  aprobadoPorId   String?  @map("aprobado_por_id") @db.Uuid
  aprobadoPorNombre String? @map("aprobado_por_nombre")
  aprobadoEn      DateTime? @map("aprobado_en") @db.Timestamptz(6)
  aprobacionMotivo String? @map("aprobacion_motivo")
  observaciones   String?
  subtotal        Decimal           @default(0) @db.Decimal(18, 4)
  descuento       Decimal           @default(0) @db.Decimal(18, 4)
  iva             Decimal           @default(0) @db.Decimal(18, 4)
  total           Decimal           @default(0) @db.Decimal(18, 4)
  /// Bolívares por 1 USD al confirmar (8 decimales). Nulo mientras es borrador.
  tasaUsd         Decimal?          @map("tasa_usd") @db.Decimal(18, 8)
  creadoPorId     String?           @map("creado_por_id") @db.Uuid
  creadoPorNombre String?           @map("creado_por_nombre")
  creadoEn        DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn   DateTime          @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  lineas          PedidoVentaLinea[]
  facturas        Factura[]

  @@index([clienteId])
  @@index([estado, fecha(sort: Desc)])
  @@map("pedido_venta")
}

model PedidoVentaLinea {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoId       String      @map("pedido_id") @db.Uuid
  pedido         PedidoVenta @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  linea          Int
  productoCodigo String      @map("producto_codigo")
  producto       Producto    @relation(fields: [productoCodigo], references: [codigo])
  descripcion    String
  cantidad       Decimal     @db.Decimal(18, 4)
  /// Precio unitario en USD, antes de descuento.
  precioUnitario Decimal     @map("precio_unitario") @db.Decimal(18, 8)
  descuento      Decimal     @default(0) @db.Decimal(7, 4)
  /// Descuento que se escribió en la línea (%), sin los globales; `descuento` es el efectivo (línea + globales) con el que se calcula el total.
  descuentoLinea Decimal? @map("descuento_linea") @db.Decimal(7, 4)
  /// Alícuota de IVA de venta del producto al momento del pedido.
  ivaPorcentaje  Decimal     @default(0) @map("iva_porcentaje") @db.Decimal(7, 4)
  total          Decimal     @default(0) @db.Decimal(18, 4)

  /// Línea regalada por una promoción «compra N, llévate M» (precio 0); la genera el sistema y se recalcula al editar el documento.
  bonificacion   Boolean  @default(false)
  presentacionId String?  @map("presentacion_id") @db.Uuid
  factor         Decimal  @default(1) @db.Decimal(18, 4)
  /// Almacén del que sale esta línea al facturar (vacío = el del documento).
  almacenId      String?  @map("almacen_id") @db.Uuid

  @@unique([pedidoId, linea])
  @@index([productoCodigo])
  @@map("pedido_venta_linea")
}

/// Reglas de aprobación gerencial (original: admaprobgerent). La 1 es el interruptor general; las demás se evalúan al cerrar un pedido.
model ReglaAprobacion {
  id            Int      @id @db.SmallInt
  descripcion   String
  monto         Decimal  @default(0) @db.Decimal(18, 4)
  activa        Boolean  @default(false)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  pedidos       PedidoVenta[]

  @@map("regla_aprobacion")
}
