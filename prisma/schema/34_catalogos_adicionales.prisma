/// Máquina o impresora fiscal de una caja: serie, serial, dirección de red y tipo de documento que imprime. Equivale a admseriefiscal.
model SerieFiscal {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serie         String   @unique
  serial        String?
  impresora     String?
  ip            String?
  /// FACTURA, NOTA_CREDITO o NOTA_DEBITO
  documento     String   @default("FACTURA")
  caja          String?
  puntoActivo   Boolean  @default(true) @map("punto_activo")
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  tiposDocumento TipoDocumento[]

  @@map("serie_fiscal")
}

/// Ubicación física dentro de un almacén (pasillo, anaquel, nivel, sector). Equivale a admubicafis.
model UbicacionFisica {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo        String   @unique
  almacenId     String   @map("almacen_id") @db.Uuid
  pasillo       String?
  anaquel       String?
  nivel         String?
  sector        String?
  comentario    String?
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  almacen       Almacen  @relation(fields: [almacenId], references: [id], onDelete: Restrict)

  @@index([almacenId])
  @@map("ubicacion_fisica")
}

/// Personas de contacto de un cliente (admpersonalcli).
model ContactoCliente {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId     String   @map("cliente_id") @db.Uuid
  nombre        String
  cargo         String?
  extension     String?
  telefono      String?
  celular       String?
  email         String?
  observaciones String?
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@map("contacto_cliente")
}

/// Sucursales o puntos de entrega de un cliente (admsucursalcli).
model SucursalCliente {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId     String   @map("cliente_id") @db.Uuid
  codigo        String
  nombre        String
  direccion     String?
  telefono      String?
  fax           String?
  celular       String?
  contacto      String?
  cargo         String?
  email         String?
  paisId        String?  @map("pais_id") @db.Uuid
  estadoId      String?  @map("estado_id") @db.Uuid
  municipioId   String?  @map("municipio_id") @db.Uuid
  parroquiaId   String?  @map("parroquia_id") @db.Uuid
  observaciones String?
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, codigo])
  @@map("sucursal_cliente")
}

/// Personas de contacto de un proveedor (admpersonalprov).
model ContactoProveedor {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proveedorId   String   @map("proveedor_id") @db.Uuid
  nombre        String
  cargo         String?
  extension     String?
  telefono      String?
  celular       String?
  email         String?
  observaciones String?
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  proveedor     Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@index([proveedorId])
  @@map("contacto_proveedor")
}
