// Catálogos y registros dependientes que faltaban frente al sistema anterior: sucursales, actividad económica, clasificaciones, divisiones, colores, tallas,
// series fiscales, ubicaciones físicas, y los contactos y sucursales de clientes y proveedores. Las referencias a otras tablas llevan su clave foránea en la migración.

model Sucursal {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo        String    @unique
  nombre        String
  direccion     String?
  telefono1     String?
  telefono2     String?
  fax           String?
  rif           String?
  email         String?
  fechaInicio   DateTime? @map("fecha_inicio") @db.Date
  fechaFin      DateTime? @map("fecha_fin") @db.Date
  paisId        String?   @map("pais_id") @db.Uuid
  estadoId      String?   @map("estado_id") @db.Uuid
  municipioId   String?   @map("municipio_id") @db.Uuid
  parroquiaId   String?   @map("parroquia_id") @db.Uuid
  activo        Boolean   @default(true)
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  almacenes     Almacen[]

  @@map("sucursal")
}

