# Copie a .env, complete PG_ADMIN_PASSWORD y ejecute: npm run local:preparar (genera el resto).
PG_HOST=127.0.0.1
PG_PORT=5432
# Superusuario solo para aprovisionar (crear bases y roles). La aplicación nunca lo usa.
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=
# --- los completa npm run local:preparar ---
# Base de control (catálogo de clientes), rol erp_plataforma
CONTROL_DATABASE_URL=
# Clave que cifra las credenciales de cada cliente guardadas en erp_control (32 bytes en base64)
CONTROL_CLAVE_MAESTRA=
SESSION_SECRET=
# Cliente por defecto cuando el host no trae subdominio (solo desarrollo)
CLIENTE_POR_DEFECTO=
# Dominio base en producción: acme.<DOMINIO_BASE> → cliente "acme"
DOMINIO_BASE=
